// Cyberpunk City — scene for the Bandit.RIP menu userscript.
// Rainy neon skyline with lightning, flying cars and flickering signs.
//
// Theme contract (the engine calls these):
//   build(env)          on start and on every resize; pre-render here
//   drawBack(t, dt)     draws everything behind the katana
//   drawFront(t, dt)    draws everything in front of the grass
//   grass: [top, bottom, back]   colours for the swaying grass
// env gives you: ctx, W, H, DPR, t, parX, parY, off(w, h) → [canvas, ctx], config, tier, gold,
// and env.flash (set it 0…1 to light up the katana and screen).

const rnd = (a, b) => a + Math.random() * (b - a);
const pick = (a) => a[(Math.random() * a.length) | 0];
const NEON = ['#ff2a4f', '#00e5ff', '#ff3cac', '#b44cff', '#ffb347'];
const WIN = [['#ffd9a0', .4], ['#6ff3ff', .2], ['#ff4fa3', .15], ['#ff2a4f', .15], ['#dfe8ff', .1]];
const pickWin = () => { let r = Math.random(); for (const [c, w] of WIN) { if ((r -= w) <= 0) return c; } return WIN[0][0]; };
const CHARS = ['酒', '夜', '龍', '電', '刀', '闇', '雨', '鬼', '光', '影', '街', '神'];

let E, W = 0, H = 0;
let sky, cloudA, cloudB, layers = [], signs = [], beacons = [], cars = [], drops = [];
let offA = 0, offB = 0, carTimer = 1;
let nextBolt = 0, bolt = null, boltLife = 0, reflash = 0;

function buildSky() {
  const [c, x] = E.off(W, H);
  const g = x.createLinearGradient(0, 0, 0, H);
  g.addColorStop(0, '#04060c'); g.addColorStop(.45, '#0b1220');
  g.addColorStop(.72, '#1c0d1f'); g.addColorStop(.86, '#3a0d22'); g.addColorStop(1, '#0a0508');
  x.fillStyle = g; x.fillRect(0, 0, W, H);
  const r = x.createRadialGradient(W * .6, H * .82, 0, W * .6, H * .82, W * .6);
  r.addColorStop(0, 'rgba(255,40,80,.33)'); r.addColorStop(1, 'rgba(255,40,80,0)');
  x.fillStyle = r; x.fillRect(0, 0, W, H);
  return c;
}

function buildClouds(count, alpha) {
  const w = W * 2, h = H * .65;
  const [c, x] = E.off(w, h);
  for (let i = 0; i < count; i++) {
    const cx = rnd(0, w), cy = rnd(-h * .1, h * .95), r = rnd(H * .07, H * .26);
    const col = cy / h > .62 ? '95,26,52' : '38,46,64';
    for (const ox of [-w, 0, w]) {
      x.save(); x.translate(cx + ox, cy); x.scale(2.3, 1);
      const g = x.createRadialGradient(0, 0, 0, 0, 0, r);
      g.addColorStop(0, `rgba(${col},${alpha})`); g.addColorStop(1, `rgba(${col},0)`);
      x.fillStyle = g; x.fillRect(-r, -r, r * 2, r * 2);
      x.restore();
    }
  }
  return c;
}

function buildCity(o) {
  const margin = W * .06, w = W + margin * 2;
  const [c, x] = E.off(w, H);
  const L = { c, w, margin, depth: o.depth };
  let bx = -10;
  while (bx < w) {
    const bw = rnd(o.minW, o.maxW), bh = rnd(o.minH, o.maxH) * H, top = o.base * H - bh;
    x.fillStyle = o.body; x.fillRect(bx, top, bw, H - top);
    if (Math.random() < .3) { const sw = bw * rnd(.3, .6), sh = bh * rnd(.05, .12); x.fillRect(bx + (bw - sw) / 2, top - sh, sw, sh); }
    // windows
    const ws = o.win, g = ws * 2, litP = o.winP * rnd(.3, 2), bcol = pickWin();
    for (let wy = top + ws * 1.5; wy < o.base * H + H * .1; wy += g) {
      for (let wx = bx + ws; wx < bx + bw - ws; wx += g) {
        if (Math.random() < litP) {
          x.globalAlpha = o.winA * rnd(.45, 1);
          x.fillStyle = Math.random() < .85 ? bcol : pickWin();
          x.fillRect(wx, wy, ws, ws * 1.2);
        }
      }
    }
    x.globalAlpha = 1;
    // rooftop neon strip
    if (o.signs && Math.random() < .18) {
      const col = pick(NEON);
      x.save(); x.shadowColor = col; x.shadowBlur = 12; x.fillStyle = col; x.fillRect(bx, top, bw, 2); x.restore();
    }
    // antenna + beacon
    if (bh > o.maxH * H * .65 && Math.random() < .5) {
      const ah = rnd(15, 45);
      x.strokeStyle = o.body; x.lineWidth = 1.5;
      x.beginPath(); x.moveTo(bx + bw / 2, top); x.lineTo(bx + bw / 2, top - ah); x.stroke();
      beacons.push({ L, x: bx + bw / 2, y: top - ah, ph: rnd(0, 6.28) });
    }
    // vertical neon sign
    if (o.signs && Math.random() < o.signs) {
      const sw = Math.max(12, Math.min(30, bw * .22)), sh = sw * Math.floor(rnd(3, 6)) * .9;
      const sx = bx + (Math.random() < .5 ? -sw * .3 : bw - sw * .7), sy = top + rnd(.08, .4) * bh;
      const col = pick(NEON);
      x.save();
      x.shadowColor = col; x.shadowBlur = 18;
      x.fillStyle = 'rgba(8,4,10,.92)'; x.fillRect(sx, sy, sw, sh);
      x.strokeStyle = col; x.lineWidth = 2; x.strokeRect(sx, sy, sw, sh);
      x.fillStyle = col; x.font = `bold ${sw * .66}px serif`; x.textAlign = 'center'; x.textBaseline = 'middle';
      const n = Math.floor(sh / (sw * .85));
      for (let i = 0; i < n; i++) x.fillText(pick(CHARS), sx + sw / 2, sy + sw * .48 + i * sw * .85);
      x.restore();
      signs.push({ L, x: sx, y: sy, w: sw, h: sh, off: 0 });
    }
    bx += bw + rnd(-2, o.gap);
  }
  return L;
}

function buildRain() {
  drops = [];
  const density = E.config.rainDensity == null ? 1 : E.config.rainDensity;
  const n = Math.floor((W * H / 3500) * density);
  for (let i = 0; i < n; i++) {
    const near = Math.random() < .4;
    drops.push({ x: rnd(-W * .1, W), y: rnd(-H, H), len: near ? rnd(18, 34) : rnd(8, 16), v: near ? rnd(900, 1300) : rnd(500, 800), near });
  }
}

function makeBolt() {
  const pts = []; let x = rnd(W * .25, W * .95), y = -10; pts.push([x, y]);
  const endY = rnd(H * .3, H * .58);
  while (y < endY) { y += rnd(12, 34); x += rnd(-26, 26); pts.push([x, y]); }
  const branches = [];
  for (let i = 0; i < 3; i++) {
    const s = pts[1 + ((Math.random() * (pts.length - 2)) | 0)]; if (!s) continue;
    let bx = s[0], by = s[1]; const b = [[bx, by]]; const dir = Math.random() < .5 ? -1 : 1;
    const k = rnd(3, 7);
    for (let j = 0; j < k; j++) { by += rnd(10, 26); bx += dir * rnd(4, 22); b.push([bx, by]); }
    branches.push(b);
  }
  return { pts, branches };
}

const lx = (L) => -L.margin + E.parX * L.depth;
const ly = (L) => E.parY * L.depth;

function drawLayer(L, t) {
  const ctx = E.ctx;
  ctx.drawImage(L.c, lx(L), ly(L), L.w, H);
  ctx.globalCompositeOperation = 'lighter';
  for (const b of beacons) {
    if (b.L !== L) continue;
    const a = Math.sin(t * 2.2 + b.ph) > .55 ? 1 : .12;
    const x = b.x + lx(L), y = b.y + ly(L);
    ctx.fillStyle = `rgba(255,40,60,${a * .25})`; ctx.beginPath(); ctx.arc(x, y, 6, 0, 6.29); ctx.fill();
    ctx.fillStyle = `rgba(255,70,80,${a})`; ctx.beginPath(); ctx.arc(x, y, 1.6, 0, 6.29); ctx.fill();
  }
  ctx.globalCompositeOperation = 'source-over';
  for (const s of signs) {
    if (s.L !== L) continue;
    if (t < s.off) { ctx.fillStyle = 'rgba(3,2,6,.82)'; ctx.fillRect(s.x + lx(L) - 3, s.y + ly(L) - 3, s.w + 6, s.h + 6); }
    else if (Math.random() < .0015) s.off = t + rnd(.05, .3);
  }
}

function drawClouds(img, o, y, a) {
  const ctx = E.ctx, w = W * 2, h = H * .65;
  ctx.globalAlpha = a;
  ctx.drawImage(img, -o, y, w, h); ctx.drawImage(img, -o + w, y, w, h);
  ctx.globalAlpha = 1;
}

function drawRain(near, dt) {
  const ctx = E.ctx;
  ctx.beginPath();
  for (const d of drops) {
    if (d.near !== near) continue;
    d.y += d.v * dt; d.x += d.v * .18 * dt;
    if (d.y > H) { d.y = -d.len - rnd(0, 60); d.x = rnd(-W * .15, W); }
    ctx.moveTo(d.x, d.y); ctx.lineTo(d.x - d.len * .18, d.y - d.len);
  }
  ctx.strokeStyle = near ? 'rgba(205,218,242,.42)' : 'rgba(165,185,220,.22)';
  ctx.lineWidth = near ? 1.4 : 1;
  ctx.stroke();
}

function drawCars(dt) {
  const ctx = E.ctx;
  carTimer -= dt;
  if (carTimer <= 0) {
    carTimer = rnd(.6, 2.2);
    const dir = Math.random() < .5 ? 1 : -1, depth = rnd(.4, 1);
    cars.push({ x: dir > 0 ? -60 : W + 60, y: H * rnd(.3, .66), v: rnd(60, 190) * dir * depth, depth, col: pick(['#ff2a4f', '#00e5ff', '#ff3cac']) });
  }
  ctx.globalCompositeOperation = 'lighter';
  for (let i = cars.length - 1; i >= 0; i--) {
    const c = cars[i]; c.x += c.v * dt;
    if (c.x < -100 || c.x > W + 100) { cars.splice(i, 1); continue; }
    const len = 34 * c.depth, dir = Math.sign(c.v);
    const g = ctx.createLinearGradient(c.x - dir * len, c.y, c.x, c.y);
    g.addColorStop(0, 'rgba(0,0,0,0)'); g.addColorStop(1, c.col);
    ctx.strokeStyle = g; ctx.lineWidth = 2 * c.depth;
    ctx.beginPath(); ctx.moveTo(c.x - dir * len, c.y); ctx.lineTo(c.x, c.y); ctx.stroke();
    ctx.fillStyle = '#fff4d6'; ctx.beginPath(); ctx.arc(c.x, c.y, 1.6 * c.depth, 0, 6.29); ctx.fill();
  }
  ctx.globalCompositeOperation = 'source-over';
}

function drawBolt() {
  if (!bolt || boltLife <= 0) return;
  const ctx = E.ctx;
  ctx.save();
  ctx.globalCompositeOperation = 'lighter';
  ctx.shadowColor = '#b9d4ff'; ctx.shadowBlur = 22;
  ctx.strokeStyle = `rgba(235,242,255,${Math.min(1, boltLife * 6)})`;
  const line = (p, w) => { ctx.lineWidth = w; ctx.beginPath(); ctx.moveTo(p[0][0], p[0][1]); for (const q of p) ctx.lineTo(q[0], q[1]); ctx.stroke(); };
  line(bolt.pts, 2.2);
  for (const b of bolt.branches) line(b, 1);
  ctx.restore();
}

BanditTheme({
  name: 'Cyberpunk City',
  grass: ['#2c0d18', '#070305', '#040203'],

  build(env) {
    E = env; W = env.W; H = env.H;
    signs = []; beacons = []; cars = [];
    sky = buildSky();
    cloudA = buildClouds(80, .5);
    cloudB = buildClouds(60, .4);
    layers = [
      buildCity({ base: .80, minH: .16, maxH: .46, minW: 18, maxW: 60,  gap: 4,  body: '#0c1020', win: 2, winP: .16, winA: .45, depth: .3, signs: 0 }),
      buildCity({ base: .85, minH: .12, maxH: .38, minW: 30, maxW: 95,  gap: 8,  body: '#070a13', win: 3, winP: .2,  winA: .7,  depth: .6, signs: .18 }),
      buildCity({ base: .91, minH: .08, maxH: .30, minW: 60, maxW: 170, gap: 18, body: '#030408', win: 4, winP: .14, winA: .9,  depth: 1,  signs: .4 }),
    ];
    buildRain();
    nextBolt = env.t + 2.5; reflash = 0; boltLife = 0; bolt = null;
  },

  drawBack(t, dt) {
    const ctx = E.ctx;
    offA = (offA + dt * 6) % (W * 2);
    offB = (offB + dt * 14) % (W * 2);

    // lightning: a bolt, then a quick second flash
    if (E.config.lightning !== false && t > nextBolt) {
      E.flash = 1; bolt = makeBolt(); boltLife = .22;
      reflash = t + rnd(.09, .17); nextBolt = t + rnd(4, 11);
    }
    if (reflash && t > reflash) { E.flash = Math.max(E.flash, .8); boltLife = .12; reflash = 0; }
    E.flash *= Math.exp(-dt * 5); boltLife -= dt;

    ctx.drawImage(sky, 0, 0, W, H);
    drawClouds(cloudA, offA, -H * .05, .85);
    drawBolt();
    drawClouds(cloudB, offB, H * .1, .65);
    if (E.flash > .02) {
      ctx.globalCompositeOperation = 'lighter';
      drawClouds(cloudA, offA, -H * .05, E.flash * .9);
      drawClouds(cloudB, offB, H * .1, E.flash * .7);
      ctx.globalCompositeOperation = 'source-over';
    }

    drawLayer(layers[0], t);
    const hz = ctx.createLinearGradient(0, H * .6, 0, H * .9);
    hz.addColorStop(0, 'rgba(255,40,90,0)'); hz.addColorStop(1, 'rgba(255,40,90,.12)');
    ctx.fillStyle = hz; ctx.fillRect(0, H * .6, W, H * .3);
    drawLayer(layers[1], t);
    if (E.config.flyingCars !== false) drawCars(dt);
    drawLayer(layers[2], t);

    const fog = ctx.createLinearGradient(0, H * .72, 0, H);
    fog.addColorStop(0, 'rgba(20,8,16,0)'); fog.addColorStop(1, 'rgba(10,4,8,.85)');
    ctx.fillStyle = fog; ctx.fillRect(0, H * .72, W, H * .28);

    drawRain(false, dt);
  },

  drawFront(t, dt) {
    drawRain(true, dt);
  },
});
